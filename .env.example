# Public base URL used by future share links and PWA metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future Laravel API base URL. The current MVP uses local mock repositories.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Feature flags for future runtime wiring. Current mock restaurant data also contains feature flags.
NEXT_PUBLIC_ENABLE_3D=true
NEXT_PUBLIC_ENABLE_AR=true
